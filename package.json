{
  "name": "lumen-minecraft-launcher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Современный лаунчер Minecraft с поддержкой Ely.by",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "web": "vite --host 0.0.0.0",
    "build": "vite build",
    "desktop": "electron .",
    "build:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/undici-compat.cjs && node --check src/lib/launcher.js && node scripts/check-undici-compat.cjs && vite build"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "@electron/get": "5.1.0",
    "shell-quote": "1.12.0",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "ru.lumen.launcher",
    "productName": "Lumen Launcher",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Lumen-Launcher-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumen Launcher",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
